node_modules/

# Generated by `npx cap sync ios` from the submodule — never committed, or the web layer
# would exist twice and the copies would drift, which is the whole thing this repo's
# structure is designed to avoid.
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/capacitor-cordova-ios-plugins/

# Xcode
ios/App/build/
ios/App/Pods/
ios/App/output/
DerivedData/
*.xcuserstate
xcuserdata/

# Signing material. Codemagic supplies these at build time from the App Store Connect
# integration; a certificate in git is a certificate that has to be revoked.
*.p8
*.p12
*.mobileprovision
*.certSigningRequest
